model notification_platforms {
  notification_platform             String                  @id(map: "PK_notification_platforms__notification_platform") @db.VarChar(50)
  notification_platform_description String?
  is_active                         Boolean                 @default(true)
  created_time                      DateTime                @default(now()) @db.Timestamp(6)
