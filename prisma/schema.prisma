model project_priority_levels {
  project_priority_level             String     @id(map: "PK_project_priority_levels__project_priority_level") @db.VarChar(50)
  project_priority_level_description String?
  is_active                          Boolean    @default(true)
  created_time                       DateTime   @default(now()) @db.Timestamp(6)
  modified_time                      DateTime?  @db.Timestamp(6)
  modified_reason                    String?
  projects                           projects[]

