model project_statuses {
  project_status             String     @id(map: "PK_project_statuses__project_status") @db.VarChar(50)
  project_status_description String?
  is_active                  Boolean    @default(true)
  created_time               DateTime   @default(now()) @db.Timestamp(6)
  modified_time              DateTime?  @db.Timestamp(6)
