model template_types {
  template_type             String     @id(map: "PK_template_types__template_type") @db.VarChar(50)
  template_type_description String?
  is_active                 Boolean    @default(true)
  created_time              DateTime   @default(now()) @db.Timestamp(6)
  modified_time             DateTime?  @db.Timestamp(6)
  modified_reason           String?
  projects                  projects[]

  @@schema("static_data")
}

model user_roles {
  role_name        String    @id(map: "PK_user_roles__role_name") @db.VarChar(50)
  role_description String?
  is_active        Boolean   @default(true)
  created_time     DateTime  @default(now()) @db.Timestamp(6)
  modified_time    DateTime? @db.Timestamp(6)
  modified_reason  String?
  users            users[]

