}

model logout_reasons {
  logout_reason             String           @id(map: "PK_logout_reasons__logout_reason") @db.VarChar(255)
  logout_reason_description String?
  is_active                 Boolean          @default(true)
  created_time              DateTime         @default(now()) @db.Timestamp(6)
  modified_time             DateTime?        @db.Timestamp(6)
  modified_reason           String?
