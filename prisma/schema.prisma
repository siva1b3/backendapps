model project_categories {
  project_category             String     @id(map: "PK_project_categories__project_category") @db.VarChar(50)
  project_category_description String?
  is_active                    Boolean    @default(true)
  created_time                 DateTime   @default(now()) @db.Timestamp(6)
  modified_time                DateTime?  @db.Timestamp(6)
  modified_reason              String?
  projects                     projects[]

  @@schema("static_data")
}

model project_member_roles {
  project_member_role             String            @id(map: "PK_project_member_roles__project_member_role") @db.VarChar(50)
  project_member_role_description String?
  is_active                       Boolean           @default(true)
  created_time                    DateTime          @default(now()) @db.Timestamp(6)
  modified_time                   DateTime?         @db.Timestamp(6)
  modified_reason                 String?
  project_members                 project_members[]

