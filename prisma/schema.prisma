}

model project_visibilities {
  project_visibility             String     @id(map: "PK_project_visibilities__project_visibility") @db.VarChar(50)
  project_visibility_description String?
  is_active                      Boolean    @default(true)
  created_time                   DateTime   @default(now()) @db.Timestamp(6)
  modified_time                  DateTime?  @db.Timestamp(6)
  modified_reason                String?
  projects                       projects[]

  @@schema("static_data")
}

model task_priority_levels {
  task_priority_level             String    @id(map: "PK_task_priority_levels__task_priority_level") @db.VarChar(50)
  task_priority_level_description String?
  is_active                       Boolean   @default(true)
  created_time                    DateTime  @default(now()) @db.Timestamp(6)
  modified_time                   DateTime? @db.Timestamp(6)
  modified_reason                 String?
  tasks                           tasks[]

  @@schema("static_data")
}

model task_statuses {
  task_status             String    @id(map: "PK_task_statuses__task_status") @db.VarChar(50)
  task_status_description String?
  is_active               Boolean   @default(true)
  created_time            DateTime  @default(now()) @db.Timestamp(6)
  modified_time           DateTime? @db.Timestamp(6)
  modified_reason         String?
  tasks                   tasks[]

  @@schema("static_data")
}

model task_types {
  task_type             String    @id(map: "PK_task_types__task_type") @db.VarChar(50)
  task_type_description String?
  is_active             Boolean   @default(true)
  created_time          DateTime  @default(now()) @db.Timestamp(6)
  modified_time         DateTime? @db.Timestamp(6)
