  @@schema("static_data")
}

model notification_events {
  notification_event             String                  @id(map: "PK_notification_events__notification_event") @db.VarChar(255)
  notification_event_description String?
  is_active                      Boolean                 @default(true)
  created_time                   DateTime                @default(now()) @db.Timestamp(6)
  modified_time                  DateTime?               @db.Timestamp(6)
  modified_reason                String?
  project_notifications          project_notifications[]

