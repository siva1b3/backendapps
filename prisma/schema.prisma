model notification_priorities {
  notification_priority             String                  @id(map: "PK_notification_priorities__notification_priority") @db.VarChar(50)
  notification_priority_description String?
  is_active                         Boolean                 @default(true)
  created_time                      DateTime                @default(now()) @db.Timestamp(6)
  modified_time                     DateTime?               @db.Timestamp(6)
